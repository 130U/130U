  "sections": [
    {
      "id": "research",
      "title": "Research",
      "blurb": "Ten works in AI evaluation and mathematical finance. Each starts from a question and ends in a result that can be checked.",
      "items": [
        {
          "repository": "RESEARCH-Agent-Evaluation-Methodology",
          "title": "Agent Evaluation Methodology",
          "line": "What must be true of a diagnosis before it is allowed to change an agent?",
          "cover": "agent-evaluation-methodology"
        },
        {
          "repository": "RESEARCH-Financial-Large-Language-Model",
          "title": "Financial Large Language Model",
          "line": "What should a financial language model be supervised to say, and what must stay fixed while its training scales?",
          "cover": "financial-large-language-model"
        },
        {
          "repository": "RESEARCH-Large-Scale-Domain-Expert-Feedback-Governance-and-Adaptive-Review",
          "title": "Large-Scale Domain Expert Feedback Governance and Adaptive Review",
          "line": "How should a post-training program spend a limited pool of expert reviewers when every review does two jobs at once?",
          "cover": "expert-feedback-governance"
        },
        {
          "repository": "RESEARCH-Financial-Task-Design-and-Synthetic-Data-Engineering",
          "title": "Financial Task Design and Synthetic Data Engineering",
          "line": "When a synthetic financial case changes one number, is its label still right?",
          "cover": "financial-task-design"
        },
        {
          "repository": "RESEARCH-General-Reasoning-Evaluation-and-Layered-Verification",
          "title": "General Reasoning Evaluation and Layered Verification",
          "line": "What should entitle a model's reasoning to be accepted?",
          "cover": "reasoning-evaluation"
        },
        {
          "repository": "RESEARCH-Evidence-Verification-and-Robust-Comparison-in-Investment-Research",
          "title": "Evidence Verification and Robust Comparison in Investment Research",
          "line": "Which investment conclusions does the evidence in hand already support, and which fact is most valuable to verify next?",
          "cover": "evidence-verification"
        },
        {
          "repository": "RESEARCH-Critical-Dependence-Stress",
          "title": "Critical Dependence Stress",
          "line": "How much dependence stress does it take to overturn a diversification gain?",
          "cover": "critical-dependence-stress"
        },
        {
          "repository": "RESEARCH-Certified-Rough-Heston-Valuation",
          "title": "Certified Joint Pricing Errors in Rough Heston",
          "line": "When every strike is priced from one approximate transform, how much numerical error is left in the portfolio?",
          "cover": "rough-heston"
        },
        {
          "repository": "RESEARCH-Certified-Valuation-Arithmetic-Asian-Options",
          "title": "Certified Valuation of Arithmetic Asian Options",
          "line": "What does it cost to exercise an average-price option on the geometric average?",
          "cover": "arithmetic-asian-options"
        },
        {
          "repository": "RESEARCH-Proxy-Tail-Anatomy-of-a-Failed-Research-Line-on-LLM-Evaluation-in-Finance",
          "title": "Proxy Tail",
          "line": "Why did a research line on LLM evaluation in finance close, and how could the same answer be reached at a fraction of the cost?",
          "cover": "proxy-tail"
        }
      ]
    },
    {
      "id": "engineering",
      "title": "Engineering",
      "blurb": "Three products built end to end, from interface to tests, and a study series on world models.",
      "items": [
        {
          "repository": "ENGINEERING-Info-Collector-2026",
          "title": "Info Collector",
          "line": "How do the articles you save become a library you actually read?",
          "cover": "info-collector"
        },
        {
          "repository": "ENGINEERING-BaZi-Context-Agent",
          "title": "BaZi Context Agent",
          "line": "Which hour were you born, and what is happening in your life now? The second answer can never change the first.",
          "cover": "bazi-context-agent"
        },
        {
          "repository": "ENGINEERING-Divination-and-Destiny-Studies",
          "title": "Divination and Destiny Studies",
          "line": "Can a language model read a chart against a life without ever calculating the chart?",
          "cover": "divination-and-destiny-studies"
        },
        {
          "repository": "ENGINEERING-World-Model-Series",
          "title": "World Model Series",
          "line": "Where should prediction meet action?",
          "cover": "world-model-series"
        }
      ]
    },
    {
      "id": "law",
      "title": "Law",
      "blurb": "Four articles from Duke Law School on who may decide under risk: in orbit, in the climate and on the coast.",
      "items": [
        {
          "repository": "LAW-Autonomous-Authority-in-Space",
          "title": "Autonomous Authority in Space",
          "line": "When may a space system act without contemporaneous human approval, and which institution decides that it may?",
          "cover": "autonomous-authority-in-space"
        },
        {
          "repository": "LAW-Small-States-and-the-Governance-of-Strategic-Space-Dependence",
